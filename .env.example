# InvisiFace Environment Configuration

# Flask Application Settings
SECRET_KEY=invisiface_super_secret_quantum_key_2026
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Database Configuration
DATABASE_URL=sqlite:///instance/invisiface.db

# Security & Encryption Settings
AES_KEY_BASE64=                                # Auto-generated 256-bit key in base64 if empty

# Quantum Processing Settings
QUANTUM_MODE=simulation                        # Options: simulation, classical, ibm
IBM_QUANTUM_TOKEN=                             # Optional IBM Quantum API token

# Upload Settings
MAX_CONTENT_LENGTH=16777216                    # 16 MB limit
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
